# LLM Provider
GEMINI_API_KEY=your-gemini-api-key

# Next.js frontend/API URL (where Next.js route handlers like /api/campaign are hosted)
# If left blank, it is automatically forwarded from each incoming chat request
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# Optional: LangSmith tracing (recommended for debugging)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sendora-agents
LANGSMITH_TRACING=false
