# ─── Server Configuration ───────────────────────────────────────────────────
# Port the Hono backend server runs on (Render sets PORT automatically)
PORT=8100
# Backend base URL for email open tracking pixels (e.g., https://your-backend.onrender.com)
BACKEND_URL=
# Allowed Vercel frontend URL for production CORS (e.g., https://your-app.vercel.app)
FRONTEND_URL=

# ─── Redis Connection (BullMQ queues) ─────────────────────────────────────────
# Use REDIS_URL for full connection strings (e.g., rediss://default:password@host.render.com:6379)
REDIS_URL=
# Or configure individual parameters:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── PostgreSQL Connection ────────────────────────────────────────────────────
# PostgreSQL connection string from Neon (e.g. postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require)
DATABASE_URL=
